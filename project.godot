; Desktop Fishing — Godot 4.6.1
config_version=5

[application]
config/name="Desktop Fishing"
config/icon="res://assets/production/ui/app-icon.png"
boot_splash/bg_color=Color(0, 0, 0, 0)
config/version="0.8.1-preview"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="DesktopFishingGodot"

[autoload]
Game="*res://scripts/services/game_service.gd"

[display]
window/per_pixel_transparency/allowed=true
window/size/transparent=true
window/size/viewport_width=1100
window/size/viewport_height=796
window/size/window_width_override=1100
window/size/window_height_override=796
window/stretch/mode="canvas_items"
window/energy_saving/keep_screen_on=false

[rendering]
viewport/transparent_background=true
gl_compatibility/driver.windows="opengl3_angle"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0, 0, 0, 0)
