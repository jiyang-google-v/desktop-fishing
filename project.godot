; Desktop Fishing — Godot 4.6.1
config_version=5

[application]
config/name="Desktop Fishing"
config/version="0.6.0-preview"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="DesktopFishingGodot"

[autoload]
Game="*res://scripts/services/game_service.gd"

[display]
window/per_pixel_transparency/allowed=true
window/size/viewport_width=1100
window/size/viewport_height=760
window/size/window_width_override=1100
window/size/window_height_override=760
window/stretch/mode="canvas_items"
window/energy_saving/keep_screen_on=false

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.929, 0.949, 0.929, 1)
